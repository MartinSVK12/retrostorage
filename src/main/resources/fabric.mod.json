{
  "schemaVersion": 1,
  "id": "retrostorage",
  "version": "${version}",
  "name": "RetroStorage",
  "description": "Digital storage mod for old versions of Minecraft, adapted to work with Better than Adventure.",
  "icon": "icon.png",
  "authors": [
    "sunsetsatellite"
  ],
  "contributors": [
    "swifterjackie - prerelease testing",
    "theMidford - testing and textures"
  ],
  "contact": {
    "homepage": "https://github.com/MartinSVK12/retrostorage/tree/bta",
    "sources": ""
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "sunsetsatellite.retrostorage.RetroStorage"
    ],
    "recipesReady": [
      "sunsetsatellite.retrostorage.RetroStorage"
    ],
    "btwaila": [
      "sunsetsatellite.retrostorage.api.impl.btwaila.BTWailaReSPlugin"
    ],
    "afterBlockInit": [
      "sunsetsatellite.retrostorage.ReSBlocks"
    ],
    "afterItemInit": [
      "sunsetsatellite.retrostorage.ReSItems"
    ],
    "client": [
      "sunsetsatellite.retrostorage.RetroStorageClient"
    ],
    "beforeClientStart": [
      "sunsetsatellite.retrostorage.RetroStorageClient"
    ],
    "afterClientStart": [
      "sunsetsatellite.retrostorage.RetroStorageClient"
    ],
    "server": [
      "sunsetsatellite.retrostorage.RetroStorageServer"
    ],
    "initModels": [
      "sunsetsatellite.retrostorage.ReSModels"
    ],
    "gatherTMBPlugins": [
      "sunsetsatellite.retrostorage.api.impl.tmb.TMBReSPlugin"
    ]
  },
  "mixins": [
    "retrostorage.mixins.json"
  ],
  "depends": {
    "minecraft": "~7.3",
    "fabricloader": ">=0.15.5",
    "catalyst-core": ">=2.3.0",
    "catalyst-fluids": ">=2.3.2",
    "catalyst-energy": ">=2.0.5",
    "catalyst-multipart": ">=2.0.3",
    "halplibe": ">=5.2.0",
    "dragonfly": ">=1.7.0-alpha.5"
  },
  "suggests": {
    "btwaila": "*",
    "tmb": "*"
  }
}
